# Gemini: create this key in Google AI Studio.
GOOGLE_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Qdrant Cloud: create a free cluster, then add its HTTPS endpoint and API key.
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=meeting_transcripts_gemini

# Whisper container settings.
WHISPER_MODEL=base
MAX_AUDIO_BYTES=104857600

# Only needed when the Next.js frontend is served from another domain locally.
FRONTEND_ORIGIN=http://localhost:3000

# Vercel Blob OIDC values are added when you connect a Blob store to a Vercel project.
# Do not add real values to Git. The app uses OIDC on Vercel and a read-write token
# only as a local-development fallback.
BLOB_STORE_ID=store_your_vercel_blob_store_id
BLOB_WEBHOOK_PUBLIC_KEY=your_vercel_blob_webhook_public_key
BLOB_READ_WRITE_TOKEN=replace_with_your_vercel_blob_token_for_local_development

# When running the Next.js frontend by itself, point it to the local FastAPI API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Required by the server-side direct-upload token route during local development.
# Use the value created by your Vercel Blob store.
BLOB_READ_WRITE_TOKEN=replace_with_your_vercel_blob_token

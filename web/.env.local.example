# When running the Next.js frontend by itself, point it to the local FastAPI API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Local-development fallback for the server-side direct-upload route.
# Vercel production uses short-lived OIDC credentials instead.
BLOB_READ_WRITE_TOKEN=replace_with_your_vercel_blob_token
NEXT_PUBLIC_MAX_MEDIA_BYTES=2147483648
